{
  "name": "computis-oss",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "chmod +x node_modules/.pnpm/@effect+tsgo-*/node_modules/@effect/tsgo-*/lib/tsc* 2>/dev/null; effect-tsgo patch --typescript --oxlint --tsrs",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint:prepare && oxlint -c oxlint.config.ts --threads=1 --report-unused-disable-directives-severity=error packages/effect-xml packages/effect-md packages/effect-pdf packages/effect-github packages/effect-eval",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r lint:prepare && pnpm -r typecheck",
    "oss:check": "node scripts/oss-check.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@effect/platform-node": "4.0.6",
    "@effect/tsgo": "0.57.0",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "26.1.2",
    "effect": "4.0.6",
    "oxc-parser": "^0.152.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.88.0",
    "oxlint-plugin-react-doctor": "0.9.14",
    "oxlint-tailwindcss": "1.10.2",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.24",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "7.0.2",
    "ultracite": "8.0.1"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.33.4"
}
