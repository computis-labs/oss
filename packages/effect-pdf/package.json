{
  "name": "@computis/effect-pdf",
  "version": "0.1.0",
  "description": "Read, render and fill PDFs with Effect, on PDFium compiled to WebAssembly and a pool of workers.",
  "homepage": "https://github.com/computis-labs/oss/tree/main/packages/effect-pdf#readme",
  "bugs": "https://github.com/computis-labs/oss/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/computis-labs/oss.git",
    "directory": "packages/effect-pdf"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/engine.ts",
    "./errors/*": "./src/errors/*.ts",
    "./server": "./src/server.ts",
    "./testing": "./src/testing.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./engine": "./dist/engine.js",
      "./errors/*": "./dist/errors/*.js",
      "./server": "./dist/server.js",
      "./testing": "./dist/testing.js",
      "./types": "./dist/types.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "bench": "node --expose-gc bench/main.ts && node bench/pool.ts && node bench/startup.ts && oxfmt bench/results",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@types/emscripten": "1.41.6"
  },
  "devDependencies": {
    "@computis/config": "workspace:*",
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@napi-rs/canvas": "1.0.9",
    "effect": "4.0.0",
    "fast-png": "8.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "tinybench": "6.2.0",
    "unpdf": "1.8.1",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@effect/platform-bun": "^4.0.0",
    "@effect/platform-node": "^4.0.0",
    "effect": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
